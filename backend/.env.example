# ── Backend (Render) ──────────────────────────────────────────────────────────
# Required
DATABASE_URL=postgresql://user:password@host/dbname
ENVIRONMENT=production
AUTH_PROVIDER=google

# Must be the same Web OAuth client ID used by the frontend.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# CORS — your Vercel frontend URL (comma-separated if multiple)
CORS_ORIGINS=https://your-app.vercel.app

# AI Providers — set at least one (all have free tiers)
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=

# Optional tuning
WORKERS=1
ADVISOR_RATE_LIMIT=10/minute
LLM_CACHE_TTL_SECONDS=3600
LOG_LEVEL=info
